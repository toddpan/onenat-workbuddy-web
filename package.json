{
  "name": "onenat-workbuddy-web",
  "version": "2026.10.7",
  "description": "OneNat WorkBuddy — 独立部署的多智能体协作 WEB 服务（基于 ONENAT 资源面 + 多 DSH 算力面：任务多轮聊天 / 子智能体 / 资源提示词注入 / LLM 编排）",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/toddpan/onenat-workbuddy.git"
  },
  "keywords": [
    "onenat",
    "workbuddy",
    "multi-agent",
    "orchestrator",
    "web-service"
  ],
  "author": "toddpan",
  "type": "module",
  "main": "./dist/server.js",
  "bin": {
    "onenat-workbuddy": "./dist/server.js"
  },
  "files": [
    "dist",
    "skills",
    "assets",
    "scripts/install-skill.sh"
  ],
  "license": "BSD-3-Clause",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "build": "bash scripts/build-standalone.sh",
    "start": "node dist/server.js",
    "smoke": "node scripts/smoke-standalone.mjs",
    "smoke:e2e": "SMOKE_E2E=1 node scripts/smoke-standalone.mjs",
    "smoke:schedules": "node scripts/smoke-schedules.mjs",
    "smoke:monitor": "node scripts/smoke-monitor.mjs",
    "smoke:ai": "node scripts/smoke-ai-skill.mjs",
    "version:bump": "node dist/date-version.js",
    "test:streaming": "node e2e-artifacts/run-streaming-tests.mjs",
    "test:streaming:e2e": "node e2e-artifacts/e2e-workbuddy-turn.mjs",
    "typecheck": "tsc -p tsconfig.server.json --noEmit",
    "test:unit": "tsc src/orchestrator.ts src/orchestrator.test.ts src/interaction-guard.test.ts --outDir dist-test --rootDir src --target ES2023 --module NodeNext --moduleResolution NodeNext --strict --skipLibCheck --esModuleInterop --types node && node --test dist-test/orchestrator.test.js dist-test/interaction-guard.test.js",
    "smoke:xiaozhi": "node scripts/smoke-xiaozhi-mcp.mjs",
    "smoke:mcp": "node scripts/smoke-mcp-server.mjs"
  },
  "dependencies": {
    "ssh2": "^1.17.0",
    "undici": "^7.0.0"
  }
}
